# Copie para .env se quiser fixar a porta local manualmente.
# Por padrao o deploy/deploy.sh ja detecta uma porta livre sozinho -
# so precisa disso se quiser forcar um valor especifico.
SOKYO_PORT=3010

# PIN do super admin (voce, dono do produto) - controla a marca (nome,
# cores, logo) em /admin, separado do PIN das familias. Escolha um PIN
# forte (nao use o mesmo "1010" das familias). Sem isso definido, a
# area /admin fica desativada (mais seguro por padrao).
ADMIN_PIN=
